---
import { brand } from "../config/brand";
import { siteData } from "../data/siteData";

const { nav } = siteData;
// const strip = (p: string) =>
//   p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;
// const currentPath = strip(Astro.url.pathname);
---

<header class="sticky top-0 z-50 w-full border-b border-white/10 bg-dark backdrop-blur-sm" transition:persist>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-5 sm:px-6">
    <div class="flex flex-col gap-2">
      <a
        href="/"
        class="font-heading text-2xl font-bold tracking-wide text-white transition-opacity hover:opacity-80"
      >
        {brand.name}
      </a>
      <span class="rounded-full text-xs font-medium text-white/80 lg:hidden">
        {siteData.license}
      </span>
    </div>

    <!-- Desktop nav -->
    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Primary navigation"
    >
      {
        nav.map(({ label, href }) => ( //{
          // const isActive =
          //   currentPath === href ||
          //   (href !== "/" && currentPath.startsWith(href));
          //return (
            <a
              href={href}
              class="rounded-md px-4 py-2.5 text-lg font-medium text-white/95 transition-colors hover:bg-white/10 hover:text-white"
              aria-current="page"//{isActive ? "page" : undefined}
              // class:list={[
              //   "rounded-md px-4 py-2.5 text-base font-medium transition-colors",
              //   isActive
              //     ? "bg-white/20 text-white"
              //     : "text-white/80 hover:bg-white/10 hover:text-white",
              // ]}
            >
              {label}
            </a>
          )) //;
        //})
      }
    </nav>

    <!-- Desktop CTA + phone -->
    <div class="hidden items-center gap-4 lg:flex">
      {
        siteData.license && (
          <span class="rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-sm font-medium text-white/80">
            {siteData.license}
          </span>
        )
      }
      <a
        href={`tel:${siteData.phoneForTel}`}
        class="text-base font-semibold text-white transition-colors hover:text-white/80"
      >
        {siteData.phoneFormatted}
      </a>
      <a
        href="/contact"
          class="inline-flex min-h-12 items-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Contact
      </a>
    </div>

    <!-- Mobile menu button — CSS-only hamburger/X animation -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="relative inline-flex min-h-12 min-w-12 items-center justify-center rounded-md text-white hover:bg-white/10 lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <span class="hamburger-box" aria-hidden="true">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="mobile-drawer"
    inert
  >
    <div class="border-t border-border bg-dark">
      <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
        {
          nav.map(({ label, href }) => (//{
            // const isActive =
            //   currentPath === href ||
            //   (href !== "/" && currentPath.startsWith(href));
            // return (
              <a
                href={href}
                class="rounded-md px-4 py-3.5 text-lg font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white"
                // class:list={[
                //   "rounded-md px-3 py-3 text-base font-medium transition-colors",
                //   isActive
                //     ? "bg-primary/10 text-white"
                //     : "text-text-muted hover:text-text hover:bg-surface",
                // ]}
              >
                {label}
              </a>
            ))// ;
          //})
        }
      </nav>

      <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4 pb-6">
        <a
          href={`tel:${siteData.phoneForTel}`}
          class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
        >
          {siteData.phoneFormatted}
        </a>
        <a
          href="/contact"
          class="flex min-h-11 items-center justify-center rounded-md bg-accent px-5 py-3 mx-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
        >
          Contact
        </a>

      </div>
    </div>
  </div>
</header>

<style>
  /* ── Hamburger bars ─────────────────────────────────────────────────────── */
  .hamburger-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
    height: 22px;
  }
  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 9999px;
    background-color: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    transform-origin: center;
  }

  /* Open state — morph to X */
  [aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  [aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile drawer slide-down ───────────────────────────────────────────── */
  .mobile-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .mobile-drawer.is-open {
    grid-template-rows: 1fr;
  }
  .mobile-drawer > div {
    min-height: 0;
    overflow: hidden;
  }

  /* Scoped display:grid overrides Tailwind's lg:hidden (layer conflict),
     so we handle the desktop breakpoint here directly. */
  @media (min-width: 1024px) {
    .mobile-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-bar,
    .mobile-drawer {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector("header") as HTMLElement;
    const btn = document.getElementById("menu-toggle") as HTMLButtonElement;
    const menu = document.getElementById("mobile-menu") as HTMLElement;
    if (!header || !btn || !menu) return;

    // Prevent duplicate listeners when transition:persist keeps the DOM
    if (header.dataset.headerInit === "true") return;
    header.dataset.headerInit = "true";

    const ACTIVE = ["bg-primary/10", "text-primary"];
    const INACTIVE_DT = ["text-text-muted", "hover:text-text"];
    const INACTIVE_MB = ["text-text-muted", "hover:text-text", "hover:bg-surface"];
    const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;
    const strip = (p: string) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p);

    let focusableEls: HTMLElement[] = [];

    function getFocusable(): HTMLElement[] {
      return Array.from(
        menu.querySelectorAll<HTMLElement>(
          'a[href], button, input, textarea, select, [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function trapFocus(e: KeyboardEvent) {
      if (e.key !== "Tab") return;
      const els = focusableEls;
      if (els.length === 0) return;
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first || document.activeElement === btn) {
          e.preventDefault();
          last.focus();
        }
      } else if (document.activeElement === last) {
        e.preventDefault();
        btn.focus();
      }
    }

    function setMenuOpen(open: boolean) {
      if (isDesktop()) open = false;
      btn.setAttribute("aria-expanded", String(open));
      menu.toggleAttribute("inert", !open);
      menu.classList.toggle("is-open", open);
      document.body.classList.toggle("overflow-hidden", open);

      if (open) {
        focusableEls = getFocusable();
        document.addEventListener("keydown", trapFocus);
      } else {
        document.removeEventListener("keydown", trapFocus);
      }
    }

    function syncActiveLinks() {
      const path = strip(window.location.pathname);
      const dtLinks = header.querySelectorAll('nav[aria-label="Primary navigation"] a');
      const mbLinks = header.querySelectorAll("#mobile-menu nav a");

      dtLinks.forEach((link) => {
        const href = strip(link.getAttribute("href") || "");
        const active = href === path || (href !== "/" && path.startsWith(href));
        link.classList.toggle(ACTIVE[0], active);
        link.classList.toggle(ACTIVE[1], active);
        link.classList.toggle(INACTIVE_DT[0], !active);
        link.classList.toggle(INACTIVE_DT[1], !active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });

      mbLinks.forEach((link) => {
        const href = strip(link.getAttribute("href") || "");
        const active = href === path || (href !== "/" && path.startsWith(href));
        link.classList.toggle(ACTIVE[0], active);
        link.classList.toggle(ACTIVE[1], active);
        link.classList.toggle(INACTIVE_MB[0], !active);
        link.classList.toggle(INACTIVE_MB[1], !active);
        link.classList.toggle(INACTIVE_MB[2], !active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    // ── Event listeners (bound once) ──────────────────────────────

    // Toggle menu
    btn.addEventListener("click", () => {
      if (isDesktop()) return;
      setMenuOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    // Close on link click inside drawer
    menu.addEventListener("click", (e) => {
      if ((e.target as Element).closest?.("a[href]")) setMenuOpen(false);
    });

    // Escape closes drawer
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        btn.focus();
      }
    });

    // Resize to desktop closes drawer
    window.addEventListener("resize", () => {
      if (isDesktop() && btn.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
      }
    });

    // ── View Transitions: reset menu & sync active links ──────────
    // Registered once — persists across navigations because the
    // header DOM (and therefore this closure) survives transition:persist.
    document.addEventListener("astro:after-swap", () => {
      setMenuOpen(false);
      syncActiveLinks();
    });

    // Initial state
    setMenuOpen(false);
    syncActiveLinks();
  }

  // astro:page-load fires on first load AND after each transition.
  // The init guard above ensures listeners only bind once.
  document.addEventListener("astro:page-load", initHeader);
</script>
