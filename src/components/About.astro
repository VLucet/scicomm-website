---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { declineImg } from '../config/images';
import { citylight } from '../config/images';
import { main_track } from '../config/images';
// Import more images here as you add them, e.g.:
// import { cityImg, backpackImg } from '../config/images';

const PLACEHOLDER = 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=900&q=80';

interface Block {
  heading: string;
  body: string[];
  image?: ImageMetadata | string;
  imageAlt: string;
  ctaLabel?: string;
  caption?: string;
  ctaHref?: string;      // leave out to hide the button
  reverse?: boolean;     // override the automatic left/right alternation
}

// ── Edit your story here. Add, remove or reorder blocks freely. ──────────
// Image/text sides alternate automatically (first block: image on the left).
const blocks: Block[] = [
  {
    heading: 'Birds populations are declining at an unprecedented rate in North America',
    body: [
      'Birds face <strong class="text-primary">compounding threats</strong> from pesticides, climate change and human-induced habitat loss and urbanization',
      '<strong class="text-primary">Migratory</strong> songbirds are among the most affected',
      'Significant mortality happens during <strong class="text-primary">migration in urban areas</strong>',
    ],
    image: declineImg ?? PLACEHOLDER,
    imageAlt: 'Figure from Rosenberg et al. 2019 showing sharp decline of birds species.',
    caption: 'Net loss of nearly 3 billion birds since 1970 (Rosenberg et al. 2019).',
    ctaLabel: 'Read More (Cornell Lab)',
    ctaHref: 'https://www.allaboutbirds.org/news/vanishing-1-in-4-birds-gone/',
  },
  {
    heading: 'Cities have nuanced et significant effects on migration',
    body: [
      'Bird habitat in cities (parks, backyards, etc) is known to be <strong class="text-primary">important stopover sites</strong> for migrating birds',
      'The artificial light cities emit at night <strong class="text-primary">affect bird behavior</strong> and is a strong predictor of stopover',
      'We need to understand <strong class="text-primary">how birds move through cities</strong> to inform conservation'
    ],
    image: citylight ?? PLACEHOLDER, // swap for your own image
    imageAlt: 'An image of Toronto at night seen from above',
    caption: 'The light pollution of Toronto at night seen from above'
  },
  {
    heading: 'To make better conservation decisions, we need higher resolution data and models',
    body: [
      '<strong class="text-primary">Miniatuzied tracking technology</strong> now allow us to collect movement data <strong class="text-primary">at finer scales </strong>',
      'Community science data offer <strong class="text-primary">large coverage at the cost of high bias</strong>',
      'These new data sources and technology pose <strong class="text-primary">statistical modeling challenges</strong> while opening <strong class="text-primary">new possibilities for resarch</strong>'
    ],
    image: main_track ?? PLACEHOLDER, // swap for your own image
    imageAlt: 'Track of a single bird in migration',
    caption: 'Track from a bird fitted with a cellular tracking device'
  },
];
---

{blocks.map((block, i) => {
  const reverse = block.reverse ?? i % 2 === 1;
  return (
    <section class="pt-6 pb-section sm:pt-8">
      <div class:list={[
          'mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:gap-14',
          reverse ? 'lg:grid-cols-[3fr_2fr]' : 'lg:grid-cols-[2fr_3fr]',
        ]}
      >

        <figure class:list={['m-0', reverse && 'lg:order-2']}>
        <div class="overflow-hidden rounded-lg">
          <Image
            src={block.image ?? PLACEHOLDER}
            alt={block.imageAlt}
            width={700}
            height={525}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="border-3 border-primary object-cover"
          />
        </div>

        {block.caption && (
          <figcaption class="mt-2 text-sm italic leading-snug text-text-muted">
            {block.caption}
          </figcaption>
        )}
      </figure>

        <!-- Content -->
        <div class:list={['space-y-2', reverse && 'lg:order-1']}>
          <h2 class="font-heading text-h2 font-bold text-primary">{block.heading}</h2>

          {block.body.map((paragraph) => (
            // <p class="text-text-muted text-xl leading-relaxed">{paragraph}</p>
            <li class="flex items-start gap-3">
              <svg
                class="mt-2 size-7 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" />
                <line x1="16" y1="8" x2="2" y2="22" />
                <line x1="17.5" y1="15" x2="9" y2="15" />
              </svg>
              <span class="text-text text-h3 leading-relaxed" set:html={paragraph} />
            </li>
          ))}

          {block.ctaHref && (
            <div class="pt-2">
              <a
                href={block.ctaHref}
                class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
              >
                {block.ctaLabel ?? 'Read More'}
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  );
})}