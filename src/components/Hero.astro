---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import { heroImage as localHeroImage } from '../config/images';
import { meImage as meImage } from '../config/images';
import { tracks as tracks } from '../config/images';
import { mtl as mtl } from '../config/images';

const PLACEHOLDER = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80';

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
  meSrc?: ImageMetadata | string;
  meAlt?: string;
  tracksSrc?: ImageMetadata | string;
  mtlSrc?: ImageMetadata | string;
}

const {
  heading = brand.tagline,
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = 'Hermit Thrush with CTT tag',
  meSrc = meImage,
  meAlt= 'Valentin Lucet',
  tracksSrc = tracks,
  mtlSrc = mtl
} = Astro.props;
---

<section class="relative overflow-hidden bg-background pt-10 pb-10 sm:pt-10 sm:pb-10 md:pt-12 md:pb-12 lg:pt-16 lg:pb-28">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12">

    <!-- Copy -->
    <div class="order-2 space-y-5 lg:order-1 lg:space-y-12">

      <!-- Top bar -->
      <!-- <div class="h-1 bg-primary"></div> -->

      <h1
        class="font-heading text-display font-bold leading-none tracking-tight text-primary test-primary"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <!-- Bottom bar -->
      <!-- <div class="h-1 bg-primary mb-12"></div> -->

      <!-- Author / Profile -->
      <div class="flex items-center gap-4 pt-2">
        <Image
          src={meSrc}
          alt={meAlt}
          width={200}
          height={200}
          class="rounded-full border-3 border-primary object-cover"
        />
        <p class="max-w-lg text-lead text-text-muted leading-relaxed">
          Hi! I'm <strong class="font-bold text-primary">Val</strong>,
          a PhD student at
          <a
            href="https://www.concordia.ca/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary underline decoration-1 underline-offset-4 hover:opacity-70"
          > Concordia University
          </a> in the <a
            href="https://www.pedersenfisherieslab.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary underline decoration-1 underline-offset-4 hover:opacity-70"
          > Pedersen Movement and Spatial Dynamics lab</a>.
          I study the <strong class="font-bold text-text">movement ecology and behavior of 
          songbirds migrating through urban areas</strong> using <a
            href="https://celltracktech.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary underline decoration-1 underline-offset-4 hover:opacity-70"
          >tiny high-tech backpacks</a> and <a
            href="https://ebird.org"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary underline decoration-1 underline-offset-4 hover:opacity-70"
          >community science data</a>.
        </p>
        <!-- <div class="space-y-1">
          <p class="font-heading text-sm font-semibold text-text">
            Val. Lucet
          </p>
          <p class="text-sm text-text-muted">
            Concordia University - Department of Biology
          </p>
        </div> -->
      </div>

    </div>

    <!-- Hero image -->
    <div
      class="relative order-1 mx-auto w-2/3 max-w-[220px] overflow-hidden lg:order-2 lg:mx-0 lg:w-full lg:max-w-none"
      transition:name="hero-image"
    >

    <!-- Hero image: overlapping image bubbles -->
    <div
      class="relative order-1 mx-auto aspect-square w-full max-w-[1000px] lg:order-2"
      transition:name="hero-image"
    >
      <!-- Main bubble -->
      <div class="absolute left-[3%] top-[8%] z-10 size-[85%] overflow-hidden rounded-full border-3 border-primary">
        <Image
          src={imageSrc}
          alt="Hermit Thrush with CTT tag"
          width={600}
          height={600}
          class="size-full object-cover"
        />
      </div>

      <!-- Top right bubble -->
      <div class="absolute right-[0%] top-[0%] z-20 size-[35%] overflow-hidden rounded-full border-3 border-primary">
        <Image
          src={mtlSrc}
          alt=""
          width={300}
          height={300}
          class="size-full object-cover"
        />
      </div>

      <!-- Bottom right bubble -->
      <div class="absolute bottom-[0%] right-[0%] z-20 size-[35%] overflow-hidden rounded-full border-3 border-primary">
        <Image
          src={tracksSrc}
          alt=""
          width={250}
          height={250}
          class="size-full object-cover"
        />
      </div>
    </div>

      <!-- <Image
        src={imageSrc}
        alt={imageAlt}
        width={950}
        height={950}
        loading="eager"
        decoding="async"
        class="rounded-full border-2 border-primary object-cover"
      /> -->
    </div>
  </div>
</section>
